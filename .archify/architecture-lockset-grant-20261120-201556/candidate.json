  "cards": [
    {
      "dot": "cyan",
      "title": "Plan, then apply",
      "items": [
        "Every mutating command builds a Plan of Change values; --dry-run renders it and stops.",
        "exec::apply is the only writer: it backs up, checks digests, and restores on failure.",
        "A plan never mixes repository and custody changes."
      ]
    },
    {
      "dot": "rose",
      "title": "Identity boundary",
      "items": [
        "Custody is the OS keychain on a terminal, LOCKSET_AGE_KEY or LOCKSET_CUSTODY, a file, or none.",
        "sops gets the key only through SOPS_AGE_KEY; it never reaches argv or a file.",
        "sops output and stderr are redacted before they are printed."
      ]
    },
    {
      "dot": "amber",
      "title": "Store invariants",
      "items": [
        ".sops.yaml is rewritten before payloads are re-wrapped against it.",
        "Rewrites of .sops.yaml touch only the age: lines and preserve its line endings.",
        "A mutation lock (.git/lockset.lock) serializes writers."
      ]
    },
    {
      "dot": "violet",
      "title": "Read paths",
      "items": [
        "status, who, and check read a Snapshot and never need to write.",
        "export prints decrypted values; run execs a child with them in its environment, scrubbed by default.",
        "lockset.toml supplies payload globs, default payloads, and custody/codec settings."
      ]
    }
  ]
